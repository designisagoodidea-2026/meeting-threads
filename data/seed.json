  "themes": [
    {
      "id": "onboarding",
      "name": "Activation",
      "color": "teal",
      "phrases": [
        "First-run completion is still flat since the last release.",
        "The empty states read better, but people still skip the checklist.",
        "Can we cut step three entirely and ask for it later?",
        "Alex wants a launch date before the end of the month.",
        "The welcome email and the in-app tour say different things."
      ],
      "actions": [
        {
          "key": "onboarding-copy-pass",
          "text": "Do one copy pass across the welcome email and the in-app tour"
        },
        {
          "key": "onboarding-launch-criteria",
          "text": "Write down launch criteria for Onboarding v3"
        },
        {
          "key": "onboarding-step-three",
          "text": "Mock a version without step three"
        }
      ]
    },
    {
      "id": "ds-debt",
      "name": "Component consistency",
      "color": "violet",
      "phrases": [
        "We have three steppers in production and none of them match.",
        "Half the color tokens in mobile are hard-coded hex values.",
        "If platform owns tokens, design systems can focus on components.",
        "Every new feature adds another one-off modal.",
        "The component audit is about sixty percent done."
      ],
      "actions": [
        {
          "key": "stepper-audit",
          "text": "Audit stepper variants across web and mobile"
        },
        {
          "key": "token-migration-estimate",
          "text": "Estimate the token migration for mobile"
        },
        {
          "key": "modal-guidelines",
          "text": "Draft modal usage guidelines"
        }
      ]
    },
    {
      "id": "research-ops",
      "name": "Evidence base",
      "color": "amber",
      "phrases": [
        "Nobody can find last quarter's interview notes.",
        "We tag studies three different ways depending on who ran them.",
        "PMs keep asking for the same insights we already have.",
        "Participant recruiting takes two weeks every time.",
        "A shared taxonomy would let us search across studies."
      ],
      "actions": [
        {
          "key": "repo-taxonomy",
          "text": "Draft a tagging taxonomy for the research repository"
        },
        {
          "key": "recruiting-panel",
          "text": "Price out a standing participant panel"
        },
        {
          "key": "insight-digest",
          "text": "Start a monthly insight digest for PMs"
        }
      ]
    },
    {
      "id": "hiring",
      "name": "Staffing",
      "color": "rose",
      "phrases": [
        "We have approval for two senior roles, maybe a third in Q2.",
        "The portfolio review is taking too long for candidates.",
        "Our loop has no one from research on it right now.",
        "Two strong candidates dropped out after the take-home.",
        "We should calibrate on what senior means before the next loop."
      ],
      "actions": [
        {
          "key": "open-reqs",
          "text": "Open the two senior design reqs with recruiting"
        },
        {
          "key": "loop-calibration",
          "text": "Write a one-page leveling guide for interviewers"
        },
        {
          "key": "drop-take-home",
          "text": "Propose replacing the take-home with a live review"
        }
      ]
    },
    {
      "id": "crit-ritual",
      "name": "Ways of working",
      "color": "sky",
      "phrases": [
        "Crits keep running over and the last presenter gets five minutes.",
        "People show finished work instead of open questions.",
        "Could presenters post the question they want answered ahead of time?",
        "Engineers stopped coming to crit after the summer.",
        "A rotating facilitator might keep it on time."
      ],
      "actions": [
        {
          "key": "crit-format",
          "text": "Propose a new crit format with time boxes"
        },
        {
          "key": "crit-facilitator",
          "text": "Set up a rotating crit facilitator schedule"
        },
        {
          "key": "crit-eng-invite",
          "text": "Invite engineering leads back to Thursday crit"
        }
      ]
    },
    {
      "id": "roadmap",
      "name": "Prioritization",
      "color": "lime",
      "phrases": [
        "Design needs a say before the H1 roadmap locks, not after.",
        "Platform work keeps losing to feature work in planning.",
        "We should size design effort the same way engineering does.",
        "Rachel wants one list of design asks by next week.",
        "The tokens work only makes sense if it is on the roadmap."
      ],
      "actions": [
        {
          "key": "h1-design-asks",
          "text": "Send one list of design asks for H1"
        },
        {
          "key": "design-sizing",
          "text": "Try t-shirt sizing for design work in planning"
        }
      ]
    },
    {
      "id": "a11y",
      "name": "Accessibility",
      "color": "slate",
      "phrases": [
        "The audit should start with checkout and onboarding.",
        "We have never tested with a screen reader end to end."
      ],
      "actions": [
        {
          "key": "a11y-scope",
          "text": "Confirm the audit scope with Studio North"
        }
      ]
    }
