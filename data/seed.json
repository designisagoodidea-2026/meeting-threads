    {
      "title": "Design team sync",
      "type": "team-sync",
      "date": "2026-11-02",
      "time": "09:30",
      "minutes": 60,
      "attendees": [
        "priya",
        "marcus",
        "lena",
        "tomas",
        "hannah",
        "dev",
        "maya"
      ],
      "themes": [
        "research-ops",
        "crit-ritual"
      ],
      "agenda": [
        "Wins from last week",
        "Research repository pain points"
      ],
      "turns": [
        {
          "s": "sam",
          "t": "0:40",
          "text": "Quick round of wins, then I want ten minutes on how we find past research."
        },
        {
          "s": "hannah",
          "t": "4:10",
          "text": "Honestly the repository is a mess. I spent an hour looking for the onboarding interviews from August.",
          "themes": [
            "research-ops"
          ]
        },
        {
          "s": "dev",
          "t": "5:02",
          "text": "We tag studies three different ways depending on who ran them.",
          "themes": [
            "research-ops"
          ]
        },
        {
          "s": "hannah",
          "t": "5:40",
          "text": "I can draft a tagging taxonomy this week if people will actually use it.",
          "themes": [
            "research-ops"
          ],
          "action": {
            "key": "repo-taxonomy",
            "text": "Draft a tagging taxonomy for the research repository",
            "owner": "hannah",
            "theme": "research-ops"
          }
        },
        {
          "s": "marcus",
          "t": "9:15",
          "text": "Separate thing, but crits keep running over. Last week I got five minutes.",
          "themes": [
            "crit-ritual"
          ]
        },
        {
          "s": "sam",
          "t": "10:02",
          "text": "That's on me. I'll bring a time-boxed format to try next week.",
          "themes": [
            "crit-ritual"
          ],
          "action": {
            "key": "crit-format",
            "text": "Propose a new crit format with time boxes",
            "owner": "sam",
            "theme": "crit-ritual"
          }
        }
      ]
    },
    {
      "title": "Design crit: onboarding v3",
      "type": "design-crit",
      "date": "2026-11-02",
      "time": "11:00",
      "minutes": 60,
      "attendees": [
        "priya",
        "marcus",
        "lena",
        "tomas",
        "alex"
      ],
      "themes": [
        "onboarding",
        "ds-debt"
      ],
      "agenda": [
        "Walk the new empty states",
        "Decide on the progress meter"
      ],
      "turns": [
        {
          "s": "priya",
          "t": "1:05",
          "text": "Two things today: the new empty states, and the progress meter, which tested badly.",
          "themes": [
            "onboarding"
          ]
        },
        {
          "s": "priya",
          "t": "6:30",
          "text": "Four of six first-time users read the meter as a loading bar.",
          "themes": [
            "onboarding"
          ]
        },
        {
          "s": "alex",
          "t": "7:45",
          "text": "I can't commit to a launch date until we know the meter works.",
          "themes": [
            "onboarding"
          ]
        },
        {
          "s": "priya",
          "t": "8:20",
          "text": "I'll rework it and retest with five new users before product review.",
          "themes": [
            "onboarding"
          ],
          "action": {
            "key": "retest-progress-meter",
            "text": "Retest the progress meter with five first-time users",
            "owner": "priya",
            "theme": "onboarding"
          }
        },
        {
          "s": "lena",
          "t": "12:10",
          "text": "Also, that stepper isn't in the system. We have three steppers in production now.",
          "themes": [
            "ds-debt"
          ]
        },
        {
          "s": "lena",
          "t": "13:00",
          "text": "Let me audit the variants before anyone builds a fourth.",
          "themes": [
            "ds-debt"
          ],
          "action": {
            "key": "stepper-audit",
            "text": "Audit stepper variants across web and mobile",
            "owner": "lena",
            "theme": "ds-debt"
          }
        }
      ]
    },
    {
      "title": "Onboarding v3 working session",
